# Copy to .env and CHANGE the passwords. .env is git-ignored.
POSTGRES_USER=oslab
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=oslab
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-too
# Used by the backend. Keep user/password/db identical to the values above.
DATABASE_URL=postgresql+psycopg://oslab:change-me-now@localhost:5432/oslab
